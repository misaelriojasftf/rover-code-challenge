#!/usr/bin/env sh

message=$(head -n1 "$1")

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'

if printf "%s" "$message" | grep -Eq "$pattern"; then
    exit 0
fi

echo ""
echo "❌ Invalid commit message."
echo ""
echo "Follow the Conventional Commits format:"
echo ""
echo "  <type>(<scope>): <description>"
echo ""
echo "Examples:"
echo "  feat: add authentication"
echo "  feat(oauth): add Google & Apple login"
echo "  fix(csv): handle empty ratings"
echo "  refactor(score): simplify calculation"
echo "  test(repository): add sorting tests"
echo "  docs(readme): update installation guide"
echo ""
echo "Allowed types:"
echo "  feat fix docs style refactor perf test build ci chore revert"
echo ""

exit 1
